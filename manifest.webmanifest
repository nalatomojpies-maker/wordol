{
  "name": "WORD4ALL",
  "short_name": "WORD4ALL",
  "description": "Nauka angielskich słówek i gramatyki dla klas 0–8 z trenerem Rychu",
  "lang": "pl",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#f1f4ff",
  "theme_color": "#5b6cff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "id": "./",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://nalatomojpies-maker.github.io/wordol/manifest.webmanifest"
    }
  ]
}